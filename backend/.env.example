OPENAI_API_KEY=replace-me
# Для OpenAI-совместимого агрегатора (если основная генерация не напрямую OpenAI):
# OPENAI_BASE_URL=https://provider.example/v1
OPENAI_CHAT_MODEL=gpt-4o-mini

# Отдельный ключ/URL только для embeddings (hybrid-поиск). Если не заданы —
# используются OPENAI_*. На европейском VPS обычно достаточно одного OPENAI_API_KEY.
# EMBEDDING_API_KEY=replace-me
# EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# Фоллбэк-LLM (DeepSeek через vedai.by). Без FALLBACK_API_KEY фоллбэк выключен.
# FALLBACK_API_KEY=replace-me
# FALLBACK_BASE_URL=https://vedai.by/api/v1
# FALLBACK_CHAT_MODEL=deepseek-v3.1

# Telegram-бот (нужен только сервису vinoterra-bot)
TELEGRAM_BOT_TOKEN=replace-me

RAG_MODE=hybrid
RAG_TOP_K=8
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Прод-домены; для локальной разработки localhost уже в дефолте
ALLOWED_ORIGINS=https://vino-terra.ru,https://www.vino-terra.ru
# За nginx ОБЯЗАТЕЛЬНО 1. При 0 бэкенд видит клиентом сам nginx (127.0.0.1),
# поэтому RATE_LIMIT_REQUESTS становится общим котлом на всех посетителей
# сразу: 11-й вопрос за минуту от любого человека получает 429, хотя он спросил
# впервые. Работает только в паре с `proxy_set_header X-Forwarded-For
# $remote_addr;` в nginx (см. deploy/nginx-vino-terra.conf) — при варианте
# $proxy_add_x_forwarded_for заголовок можно подделать и лимита не будет вообще.
TRUST_PROXY_HEADERS=0
# Swagger /docs: 1 — включить (локально), 0 — выключить (прод)
ENABLE_API_DOCS=0

# Лог вопросов/оценок (SQLite). Пустая строка отключает лог.
FEEDBACK_DB=feedback/feedback.db

API_HOST=127.0.0.1
PORT=8080
